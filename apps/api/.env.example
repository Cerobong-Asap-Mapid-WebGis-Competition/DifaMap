PORT=4000
NODE_ENV=production

# Supabase PostgreSQL Database with PostGIS
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.co:5432/postgres"

# Supabase Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# OpenAI API Key (untuk scoring aksesibilitas dan chatbot)
OPENAI_API_KEY="sk-..."

# MAPID Credentials & Endpoints
MAPID_API_KEY="your-mapid-api-key"
MAPID_BASE_URL="https://api.mapid.io"
MAPID_BASEMAP_URL="https://basemap.mapid.io"
MAPID_GEOSERVER_URL="https://geoserver.mapid.io"
MAPID_COMPETITION_URL="https://server.mapid.io/web/competition"
