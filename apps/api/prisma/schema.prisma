// Prisma Schema for DifaMap WebGIS Backend
// Integrates with Supabase Auth, PostgreSQL, and PostGIS Geospatial Extension

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

enum Role {
  USER
  SURVEYOR
  ADMIN
}

// 2 Jenis Entitas Spasial Utama: Tempat vs Jalan/Trotoar vs Titik Transit
enum EntityType {
  PLACE            // Mall, Tempat Wisata, Restoran, Fasilitas Publik, dll
  SIDEWALK         // Segmen Jalan / Jalur Trotoar Pedestrian
  TRANSIT_HUB      // Halte Bus, Stasiun Kereta, Titik Transit
}

enum PlaceCategory {
  MALL
  RESTAURANT
  TOURISM
  HEALTHCARE
  EDUCATION
  GOVERNMENT
  TRANSIT_STATION
  BUS_STOP
  PEDESTRIAN_PATH
  OTHER
}

// ==========================================
// PARAMETER KONDISI FISIK & AKSESIBILITAS
// ==========================================

enum RampStatus {
  GOOD             // Ada & kondisi baik / ramah kursi roda (< 8% kelandaian)
  DAMAGED          // Ada tapi rusak / terlalu curam / terhalang / tanpa pegangan
  NONE             // Tidak ada ramp
  NOT_VISIBLE      // Belum diobservasi / tidak terlihat
}

enum GuidingBlockStatus {
  GOOD             // Ada & tersambung dengan baik
  DAMAGED          // Ada tapi rusak / terputus / terhalang
  NONE             // Tidak ada ubin pemandu sama sekali
  NOT_VISIBLE      // Belum diobservasi / tidak terlihat
}

enum SidewalkCondition {
  GOOD             // Trotoar lebar, rata, dan nyaman
  NARROW           // Trotoar sempit (< 1.2 meter)
  DAMAGED          // Trotoar berlubang / paving terlepas
  BLOCKED          // Terhalang PKL, tiang, kabel, parkir liar
  NOT_APPLICABLE   // Bukan jalan trotoar (misal: bangunan mall/indoor)
  NOT_VISIBLE      // Belum diobservasi / tidak terlihat
}

enum SurfaceCondition {
  SMOOTH           // Halus / rata / paving rapi
  SLIPPERY         // Licin (terutama saat basah/keramik)
  POTHOLE          // Berlubang / pecah-pecah
  UNEVEN           // Bergelombang / berbatu
  NOT_VISIBLE      // Belum diobservasi / tidak terlihat
}

enum SeatingAvailability {
  AVAILABLE        // Tersedia tempat duduk / istirahat
  NOT_AVAILABLE    // Tidak ada tempat istirahat
  NOT_VISIBLE      // Belum diobservasi / tidak terlihat
}

enum ToiletAccessibility {
  AVAILABLE_GOOD   // Tersedia toilet ramah disabilitas layak pakai
  AVAILABLE_DAMAGED // Tersedia tapi rusak / sempit / tidak terawat
  NOT_AVAILABLE    // Tidak tersedia toilet disabilitas
  NOT_VISIBLE      // Belum diobservasi / tidak terlihat
}

// ==========================================
// PARAMETER KEAMANAN & KENYAMANAN
// ==========================================

enum LightingLevel {
  BRIGHT           // Sangat terang / lampu jalan aktif & merata
  DIM              // Redup / pencahayaan minim
  DARK             // Gelap / tidak ada lampu jalan
  NOT_VISIBLE      // Belum diobservasi / tidak terlihat
}

enum CrowdLevel {
  QUIET            // Sepi
  MODERATE         // Sedang / normal
  CROWDED          // Ramai / sangat padat
  NOT_VISIBLE      // Belum diobservasi / tidak terlihat
}

// ==========================================
// PARAMETER TEMPORAL (WAKTU)
// ==========================================

enum WeeklyPattern {
  WEEKDAY_BUSY     // Lebih ramai saat hari kerja (Senin-Jumat)
  WEEKEND_BUSY     // Lebih ramai saat akhir pekan (Sabtu-Minggu)
  BALANCED         // Relatif seimbang setiap hari
}

enum ActivityStatus {
  DRAFT
  PUBLIC
  ARCHIVED
}

enum EconomicType {
  MENU_GO       // Data kuliner & UMKM
  PROPERTI_GO   // Data properti & kepadatan bangunan
  COMMERCIAL    // Kawasan perdagangan / jasa
}

// ==========================================
// MODELS / TABLES
// ==========================================

// Model User: Terhubung dengan Supabase Auth (auth.users)
model User {
  id         String     @id @db.Uuid
  email      String     @unique
  name       String?
  avatarUrl  String?    @map("avatar_url")
  role       Role       @default(USER)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  activities Activity[]
  comments   Comment[]

  @@map("users")
}

// Model Location: Tempat (Mall, Wisata, Resto, Halte) dan Ruas Jalan/Trotoar
model Location {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  entityType            EntityType          @default(PLACE) @map("entity_type")
  category              PlaceCategory       @default(OTHER)
  specificLocation      String?             @map("specific_location") // Alamat detail / patokan
  description           String?             @db.Text
  coverImageUrl         String?             @map("cover_image_url")

  // Koordinat spasial
  latitude              Float
  longitude             Float
  geom                  Unsupported("geometry(Point, 4326)")?

  // Parameter Fisik & Aksesibilitas Terkini (Default NOT_VISIBLE sebelum diobservasi)
  rampStatus            RampStatus          @default(NOT_VISIBLE) @map("ramp_status")
  guidingBlockStatus    GuidingBlockStatus  @default(NOT_VISIBLE) @map("guiding_block_status")
  sidewalkCondition     SidewalkCondition   @default(NOT_VISIBLE) @map("sidewalk_condition")
  surfaceCondition      SurfaceCondition    @default(NOT_VISIBLE) @map("surface_condition")
  seatingAvailability   SeatingAvailability @default(NOT_VISIBLE) @map("seating_availability")
  toiletAccessibility   ToiletAccessibility @default(NOT_VISIBLE) @map("toilet_accessibility")

  // Parameter Keamanan & Kenyamanan
  lightingLevel         LightingLevel       @default(NOT_VISIBLE) @map("lighting_level")
  crowdLevel            CrowdLevel          @default(NOT_VISIBLE) @map("crowd_level")

  // Parameter Temporal (Waktu)
  peakHours             String?             @map("peak_hours") // Contoh: "07:00-09:00, 17:00-19:30"
  safeVisitTime         String?             @map("safe_visit_time") // Contoh: "08:00 - 17:00"
  weeklyPattern         WeeklyPattern       @default(BALANCED) @map("weekly_pattern")

  // Scoring & AI Insights Resmi dari Data Survei
  overallScore          Float               @default(0.0) @map("overall_score") // 1.0 - 5.0 (Rating Bintang)
  physicalScore         Float               @default(0.0) @map("physical_score") // 1.0 - 5.0
  safetyScore           Float               @default(0.0) @map("safety_score") // 1.0 - 5.0
  aiConfidence          Float?              @map("ai_confidence") // Keyakinan AI (0.0 - 1.0)
  aiSummary             String?             @db.Text @map("ai_summary") // Ringkasan poin-poin aksesibilitas
  aiInsights            Json?               @map("ai_insights") // Rekomendasi perbaikan & detail parameter

  // Skor Komunitas (Terpisah dari Skor Resmi Survei)
  communityScore        Float?              @map("community_score") // 1.0 - 5.0 (Agregat laporan publik)
  communityReportCount  Int                 @default(0) @map("community_report_count")

  // Analisis Spasial Ekonomi MAPID
  economicScore         Float               @default(0.0) @map("economic_score") // 0.0 - 100.0 (Kerapatan Menu/Properti Go)
  priorityIndex         Float               @default(0.0) @map("priority_index") // Indeks prioritas intervensi

  totalActivities       Int                 @default(0) @map("total_activities")
  totalComments         Int                 @default(0) @map("total_comments")

  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  activities            Activity[]
  comments              Comment[]

  @@index([entityType])
  @@index([category])
  @@index([overallScore])

  // Index spasial GIST dideklarasikan di sini, bukan hanya di skrip SQL manual.
  // Kalau tidak, setiap `prisma db push` akan menghapusnya tanpa pesan apa pun -
  // aplikasi tetap jalan, hanya pelan, jadi hilangnya tidak akan ketahuan.
  //
  // `map` menyebut nama index yang sudah ada di database supaya Prisma
  // mengakuinya, bukan membuat index kembar bernama *_geom_idx.
  //
  // PERHATIAN: index ekspresi `idx_locations_geog` di atas kolom (geom::geography)
  // tidak bisa dinyatakan di Prisma. Itulah yang sebenarnya dipakai oleh query
  // ST_DWithin, dan `db push` bisa menghapusnya. Sesudah setiap `db push`,
  // jalankan ulang prisma/migrations_manual/01_postgis_triggers_rpc.sql.
  @@index([geom], type: Gist, map: "idx_locations_geom")
  @@map("locations")
}

// Model Activity: Crowdsourced Postingan Komunitas / Story / Laporan Foto
model Activity {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  locationId         String?            @map("location_id") @db.Uuid // Opsional: jika ditag ke Location tertentu

  title              String             // Activity Name (misal: "Mampir lihat Danau UNHAS")
  description        String             @db.Text // Activity Description
  mediaUrls          String[]           @default([]) @map("media_urls") // Foto-foto yang diunggah
  specificLocation   String?            @map("specific_location") // Nama tempat / jalan spesifik dari user

  // Koordinat Pick Location pada Map
  latitude           Float
  longitude          Float
  geom               Unsupported("geometry(Point, 4326)")?

  status             ActivityStatus     @default(PUBLIC)
  accessibilityTags  String[]           @default([]) @map("accessibility_tags") // e.g. ["Kursi Roda", "Ramp Bagus", "Trotoar Sempit"]

  // Hasil Ekstraksi & Scoring Otomatis oleh AI Orchestrator
  aiScore            Float?             @map("ai_score") // Skor 1.0 - 5.0 dari AI
  aiConfidence       Float?             @map("ai_confidence") // Keyakinan AI (0.0 - 1.0)
  aiAnalysis         Json?              @map("ai_analysis") // Ekstraksi rintangan, isu, rekomendasi
  observedParameters Json?              @map("observed_parameters") // Parameter fisik yang terdeteksi

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  location           Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  comments           Comment[]

  @@index([userId])
  @@index([locationId])
  @@index([status])

  // Index spasial GIST dideklarasikan di sini, bukan hanya di skrip SQL manual.
  // Kalau tidak, setiap `prisma db push` akan menghapusnya tanpa pesan apa pun -
  // aplikasi tetap jalan, hanya pelan, jadi hilangnya tidak akan ketahuan.
  //
  // `map` menyebut nama index yang sudah ada di database supaya Prisma
  // mengakuinya, bukan membuat index kembar bernama *_geom_idx.
  //
  // PERHATIAN: index ekspresi `idx_activities_geog` di atas kolom (geom::geography)
  // tidak bisa dinyatakan di Prisma. Itulah yang sebenarnya dipakai oleh query
  // ST_DWithin, dan `db push` bisa menghapusnya. Sesudah setiap `db push`,
  // jalankan ulang prisma/migrations_manual/01_postgis_triggers_rpc.sql.
  @@index([geom], type: Gist, map: "idx_activities_geom")
  @@map("activities")
}

// Model Comment: Komentar / Ulasan dari User Terautentikasi untuk Location atau Activity
model Comment {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  locationId         String?            @map("location_id") @db.Uuid
  activityId         String?            @map("activity_id") @db.Uuid

  content            String             @db.Text
  photoUrls          String[]           @default([]) @map("photo_urls")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  location           Location?          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  activity           Activity?          @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([locationId])
  @@index([activityId])
  @@map("comments")
}

// Model EconomicPoint: Menyimpan data spasial sekunder (Menu Go & Properti Go)
model EconomicPoint {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  type               EconomicType
  weight             Float              @default(1.0) // Bobot aktivitas (misal: foot traffic / kapasitas)
  latitude           Float
  longitude          Float
  geom               Unsupported("geometry(Point, 4326)")?
  metadata           Json?

  createdAt          DateTime           @default(now()) @map("created_at")


  // Index spasial GIST dideklarasikan di sini, bukan hanya di skrip SQL manual.
  // Kalau tidak, setiap `prisma db push` akan menghapusnya tanpa pesan apa pun -
  // aplikasi tetap jalan, hanya pelan, jadi hilangnya tidak akan ketahuan.
  //
  // `map` menyebut nama index yang sudah ada di database supaya Prisma
  // mengakuinya, bukan membuat index kembar bernama *_geom_idx.
  //
  // PERHATIAN: index ekspresi `idx_economic_points_geog` di atas kolom (geom::geography)
  // tidak bisa dinyatakan di Prisma. Itulah yang sebenarnya dipakai oleh query
  // ST_DWithin, dan `db push` bisa menghapusnya. Sesudah setiap `db push`,
  // jalankan ulang prisma/migrations_manual/01_postgis_triggers_rpc.sql.
  @@index([geom], type: Gist, map: "idx_economic_points_geom")
  @@map("economic_points")
}

