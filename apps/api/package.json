{
  "name": "@difamap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate && node scripts/sync-prisma.js",
    "db:push": "prisma db push && node scripts/sync-prisma.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "score:ai": "tsx scripts/score-locations-openai.ts",
    "score:ai:test": "tsx scripts/score-locations-openai.ts --test",
    "score:ai:all": "tsx scripts/score-locations-openai.ts --all",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.8.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
